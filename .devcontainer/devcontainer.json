{
  "name": "Nebula Cadet Terminal",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "hostRequirements": {
    "cpus": 2
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.nebula/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "markdown.preview.breaks": true
      }
    }
  }
}
